---
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo-bilancio.png';
import { AUTH_URLS } from '../config/auth';

const navigation = [
  { href: '/', label: 'Inicio' },
  { href: '/finanzas-personales/', label: 'Finanzas personales' },
  { href: '/gastos-grupales/', label: 'Gastos grupales' },
  { href: '/como-funciona/', label: 'Cómo funciona' },
];

---

<header class="site-header">
  <div class="site-header__inner">
    <a class="brand" href="/" aria-label="Bilancio, inicio">
      <Image src={logo} width={144} height={48} format="webp" quality={88} alt="" />
    </a>

    <nav class="desktop-navigation" aria-label="Principal">
      {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <details class="mobile-navigation">
      <summary>Menú</summary>
      <nav aria-label="Principal">
        {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
        <a class="mobile-navigation__login" href={AUTH_URLS.login}>Ingresar</a>
      </nav>
    </details>

    <nav class="site-header__actions" aria-label="Acceso a Bilancio">
      <a class="site-header__login" href={AUTH_URLS.login}>Ingresar</a>
      <a class="button button--primary site-header__register" href={AUTH_URLS.register}>Crear cuenta</a>
    </nav>
  </div>
</header>
