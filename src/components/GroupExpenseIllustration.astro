<figure class="expense-illustration" aria-labelledby="expense-illustration-title">
  <div class="expense-illustration__header">
    <div>
      <p class="expense-illustration__eyebrow">Grupo · Viaje</p>
      <h2 id="expense-illustration-title">Escapada a Bariloche</h2>
      <p class="expense-illustration__meta">Abierto <span aria-hidden="true">·</span> ARS</p>
    </div>
    <ul class="expense-illustration__people" aria-label="Participantes: Ana, Beto y Caro">
      <li class="person person--ana">A</li>
      <li class="person person--beto">B</li>
      <li class="person person--caro">C</li>
    </ul>
  </div>

  <section class="expense-illustration__expense" aria-labelledby="illustration-expense-title">
    <div class="illustration-icon" aria-hidden="true">⌂</div>
    <div>
      <h3 id="illustration-expense-title">Casa de alquiler</h3>
      <p>Ana pagó · repartido entre 3</p>
    </div>
    <strong>ARS 18.000</strong>
  </section>

  <section class="expense-illustration__balances" aria-labelledby="illustration-balances-title">
    <div class="illustration-section-heading">
      <h3 id="illustration-balances-title">Balances</h3>
      <span>Después de este gasto</span>
    </div>
    <dl>
      <div><dt><i class="person person--ana">A</i>Ana</dt><dd class="balance-positive">+ARS 12.000</dd></div>
      <div><dt><i class="person person--beto">B</i>Beto</dt><dd>−ARS 6.000</dd></div>
      <div><dt><i class="person person--caro">C</i>Caro</dt><dd>−ARS 6.000</dd></div>
    </dl>
  </section>

  <section class="expense-illustration__suggestions" aria-labelledby="illustration-suggestions-title">
    <div class="illustration-section-heading">
      <h3 id="illustration-suggestions-title">Sugerencias para saldar</h3>
      <span aria-hidden="true">↗</span>
    </div>
    <ul>
      <li><span>Beto</span><span class="suggestion-arrow" aria-hidden="true">→</span><span>Ana</span><strong>ARS 6.000</strong></li>
      <li><span>Caro</span><span class="suggestion-arrow" aria-hidden="true">→</span><span>Ana</span><strong>ARS 6.000</strong></li>
    </ul>
  </section>

  <p class="expense-illustration__note">Las sugerencias orientan; no son transferencias realizadas.</p>
  <figcaption>Ilustración conceptual · nombres e importes sintéticos · no es una captura de la aplicación.</figcaption>
</figure>
