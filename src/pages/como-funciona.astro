---
import BaseLayout from '../layouts/BaseLayout.astro';
import { AUTH_URLS } from '../config/auth';
import '../styles/product-pages.css';

const description =
  'Conocé cómo Bilancio reúne tus finanzas personales y los gastos que compartís, desde el registro cotidiano hasta una consulta más clara.';

const personalSteps = [
  { number: '01', title: 'Organizá tus cuentas', text: 'Elegí cuentas y categorías para ubicar tus ingresos y gastos.' },
  { number: '02', title: 'Registrá tus movimientos', text: 'Anotá cada movimiento y volvé a consultarlo desde el listado.' },
];

const groupSteps = [
  { number: '01', title: 'Armá un grupo', text: 'Creá un espacio para un viaje, una salida u otro plan compartido.' },
  { number: '02', title: 'Repartí los gastos', text: 'Registrá quién pagó, distribuí importes y revisá los balances.' },
];
---

<BaseLayout title="Cómo funciona Bilancio" description={description}>
  <div class="product-page how-it-works-page">
    <section class="product-hero how-hero" aria-labelledby="how-page-title">
      <div class="product-hero__copy">
        <p class="eyebrow">Dos formas de llevar tus cuentas</p>
        <h1 id="how-page-title">Lo personal y lo compartido, más claro.</h1>
        <p class="product-hero__description">
          Bilancio te ayuda a registrar tus movimientos cotidianos y a organizar gastos con otras personas desde la misma aplicación.
        </p>
        <div class="product-hero__actions">
          <a class="button button--primary" href={AUTH_URLS.register}>Crear cuenta</a>
          <a class="text-link" href="#dos-formas">Descubrí el recorrido <span aria-hidden="true">↓</span></a>
        </div>
      </div>
      <div class="how-hero__visual" aria-label="Las dos áreas públicas de Bilancio">
        <article class="how-path-card how-path-card--personal">
          <span class="how-path-card__index">01</span>
          <span class="how-path-card__symbol" aria-hidden="true">◷</span>
          <p class="eyebrow">Finanzas personales</p>
          <h2>Lo que entra y sale de tus cuentas.</h2>
          <span class="how-path-card__footer">Ingresos · gastos · categorías</span>
        </article>
        <article class="how-path-card how-path-card--groups">
          <span class="how-path-card__index">02</span>
          <span class="how-path-card__symbol" aria-hidden="true">◎</span>
          <p class="eyebrow">Gastos grupales</p>
          <h2>Lo que compartís con otras personas.</h2>
          <span class="how-path-card__footer">Grupos · gastos · balances</span>
        </article>
        <p class="how-hero__caption">Ilustración conceptual · dos áreas del producto.</p>
      </div>
    </section>

    <section class="how-paths" id="dos-formas" aria-labelledby="how-paths-title">
      <div class="product-section-heading">
        <p class="eyebrow">Un producto, dos situaciones cotidianas</p>
        <h2 id="how-paths-title">Elegí qué necesitás ordenar.</h2>
        <p>Podés usar Bilancio para tu registro personal, para los gastos de un grupo o para ambas cosas.</p>
      </div>

      <div class="how-path-grid">
        <article class="how-path-detail how-path-detail--personal" aria-labelledby="personal-path-title">
          <p class="eyebrow">En tus finanzas personales</p>
          <h3 id="personal-path-title">Una vista de tus movimientos.</h3>
          <ol>
            {personalSteps.map((step) => <li><span>{step.number}</span><div><h4>{step.title}</h4><p>{step.text}</p></div></li>)}
          </ol>
          <a class="text-link" href="/finanzas-personales/">Conocer finanzas personales <span aria-hidden="true">→</span></a>
        </article>

        <article class="how-path-detail how-path-detail--groups" aria-labelledby="group-path-title">
          <p class="eyebrow">Con otras personas</p>
          <h3 id="group-path-title">Las cuentas del plan, en común.</h3>
          <ol>
            {groupSteps.map((step) => <li><span>{step.number}</span><div><h4>{step.title}</h4><p>{step.text}</p></div></li>)}
          </ol>
          <a class="text-link" href="/gastos-grupales/">Conocer gastos grupales <span aria-hidden="true">→</span></a>
        </article>
      </div>
    </section>

    <section class="how-start" aria-labelledby="how-start-title">
      <div class="how-start__mark" aria-hidden="true">↗</div>
      <div>
        <p class="eyebrow">Para empezar</p>
        <h2 id="how-start-title">Ingresá a Bilancio y elegí por dónde comenzar.</h2>
        <p>Desde la aplicación podés acceder a tus finanzas personales y a los grupos según los permisos disponibles para tu cuenta.</p>
        <a class="button button--primary" href={AUTH_URLS.register}>Crear cuenta</a>
      </div>
    </section>

    <section class="product-final-cta how-final-cta" aria-labelledby="how-cta-title">
      <p class="eyebrow">Cuentas más claras, día a día</p>
      <h2 id="how-cta-title">Conocé Bilancio.</h2>
      <p>Elegí la forma de organizar tus cuentas que tiene sentido para vos.</p>
      <a class="button button--primary" href={AUTH_URLS.register}>Crear cuenta</a>
    </section>
  </div>
</BaseLayout>
