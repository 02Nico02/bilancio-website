---
import BaseLayout from '../layouts/BaseLayout.astro';
import { AUTH_URLS } from '../config/auth';
import '../styles/product-pages.css';

const description =
  'Conocé cómo Bilancio reúne tus finanzas personales y los gastos que compartís, desde el registro cotidiano hasta una consulta más clara.';

const moments = [
  { number: '01', title: 'Organizá tus movimientos', text: 'Consultá ingresos y gastos por fecha, categoría y cuenta, con cada moneda por separado.', key: 'movements', desktop: '/images/finanzas-movimientos-desktop.webp', mobile: '/images/finanzas-movimientos-mobile.webp', width: 1245, height: 560, mobileWidth: 380, mobileHeight: 1060, alt: 'Cinco movimientos sintéticos de octubre de 2026 en ARS, con fecha, descripción, tipo, categoría y cuenta.' },
  { number: '02', title: 'Entendé el resultado del mes', text: 'Revisá el resultado de tus cuentas y consultá los totales en ARS y USD por separado.', key: 'dashboard', desktop: '/images/resumen-home-desktop.webp', mobile: '/images/resumen-home-mobile.webp', width: 1092, height: 373, mobileWidth: 390, mobileHeight: 930, alt: 'Dashboard sintético con resultados en ARS y USD presentados por separado.' },
  { number: '03', title: 'Compartí gastos', text: 'Revisá los gastos del grupo y sus balances. Las sugerencias para saldar no son pagos ejecutados.', key: 'groups', desktop: '/images/gastos-detalle-desktop.webp', mobile: '/images/gastos-detalle-mobile.webp', width: 1092, height: 620, mobileWidth: 358, mobileHeight: 1000, alt: 'Grupo sintético Escapada a la Patagonia, con tres integrantes, gastos y balances en ARS.' },
];
---

<BaseLayout title="Cómo funciona Bilancio" description={description}>
  <div class="product-page how-it-works-page">
    <section class="product-hero how-hero" aria-labelledby="how-page-title">
      <div class="product-hero__copy">
        <p class="eyebrow">Tres capacidades de Bilancio</p>
        <h1 id="how-page-title">Tus cuentas, más claras.</h1>
        <p class="product-hero__description">
          Bilancio te ayuda a registrar tus movimientos cotidianos y a organizar gastos con otras personas desde la misma aplicación.
        </p>
        <div class="product-hero__actions">
          <a class="button button--primary" href={AUTH_URLS.register}>Crear cuenta</a>
          <a class="text-link" href="#dos-formas">Descubrí el recorrido <span aria-hidden="true">↓</span></a>
        </div>
      </div>
      <p class="product-hero__description">Explorá distintas herramientas según lo que quieras organizar.</p>
    </section>

    <section class="how-paths how-moments" id="dos-formas" aria-labelledby="how-paths-title">
      <div class="product-section-heading">
        <p class="eyebrow">Un producto, distintas situaciones</p>
        <h2 id="how-paths-title">Tres formas de entender tus cuentas.</h2>
        <p>Son capacidades independientes para consultar y organizar tu información.</p>
      </div>

      <div class="how-moments__list">
        {moments.map((moment) => (
          <article class={`how-moment how-moment--${moment.key}`}>
            <div class="how-moment__copy"><p class="eyebrow">Momento {moment.number}</p><h3>{moment.title}</h3><p>{moment.text}</p></div>
            <figure class="how-moment__capture"><picture><source media="(max-width: 42rem)" srcset={moment.mobile} width={moment.mobileWidth} height={moment.mobileHeight} /><img src={moment.desktop} width={moment.width} height={moment.height} loading={moment.number === '01' ? 'eager' : 'lazy'} fetchpriority={moment.number === '01' ? 'high' : 'auto'} decoding="async" alt={moment.alt} /></picture><figcaption>Captura auténtica de Bilancio · datos sintéticos</figcaption></figure>
          </article>
        ))}
      </div>
    </section>

    <section class="how-start" aria-labelledby="how-start-title">
      <div class="how-start__mark" aria-hidden="true">↗</div>
      <div>
        <p class="eyebrow">Para empezar</p>
        <h2 id="how-start-title">Ingresá a Bilancio y elegí por dónde comenzar.</h2>
        <p>Desde la aplicación podés acceder a tus finanzas personales y a los grupos según los permisos disponibles para tu cuenta.</p>
        <a class="button button--primary" href={AUTH_URLS.register}>Crear cuenta</a>
      </div>
    </section>

    <section class="product-final-cta how-final-cta" aria-labelledby="how-cta-title">
      <p class="eyebrow">Cuentas más claras, día a día</p>
      <h2 id="how-cta-title">Conocé Bilancio.</h2>
      <p>Elegí la forma de organizar tus cuentas que tiene sentido para vos.</p>
      <a class="button button--primary" href={AUTH_URLS.register}>Crear cuenta</a>
    </section>
  </div>
</BaseLayout>
